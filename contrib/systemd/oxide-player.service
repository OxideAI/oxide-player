[Unit]
Description=oxide-player — audiophile MPD + CamillaDSP controller
Documentation=https://github.com/OxideAI/oxide-player
# Start only once MPD and CamillaDSP are ready.
After=network-online.target mpd.service camilladsp.service
Wants=mpd.service camilladsp.service
RequiresMountsFor=/var/lib/oxide-player

[Service]
Type=simple
User=oxide
Group=oxide
# Run from the data dir so relative paths in the config resolve predictably.
WorkingDirectory=/var/lib/oxide-player
ExecStart=/usr/local/bin/oxide-player -c /etc/oxide-player/config.json
# Higher scheduling priority for glitch-free audio under load.
Nice=-5
# Restart on crash, but not on clean exit (exit code 0).
Restart=on-failure
RestartSec=3
# Cap logging; journald captures stdout/stderr.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=oxide-player
# The default config binds 0.0.0.0:80. Ports below 1024 are privileged, so
# grant the ambient capability that lets a non-root User=oxide bind to it.
# install.sh keeps the same listen address; if you change `listen` to a
# port >= 1024, drop this line (capability grant is then a no-op).
#
# NOTE: do NOT add a CapabilityBoundingSet here. Restricting the bounding set
# drops CAP_SETUID/CAP_SETGID, which breaks the backend's `sudo -n systemctl
# reboot|poweroff` used by the Settings power buttons (the process cannot
# escalate to run systemctl). The ambient capability alone grants the port-80
# bind without narrowing the bounding set.
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
